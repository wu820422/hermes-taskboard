{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hermes-taskboard-v2",
  "main": "cloud/src/index.mjs",
  "compatibility_date": "2026-07-24",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hermes-taskboard-v2-db",
      "database_id": "dd1139b3-cb1b-43b9-b9be-84e66e59fbd8",
      "migrations_dir": "cloud/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "hermes-taskboard-v2-attachments"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_HUB",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-realtime-hub",
      "new_sqlite_classes": ["RealtimeHub"]
    }
  ]
}
